# Provider credentials (keys stay in environment variables)
ORB_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional model/voice overrides
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin

# Optional config/prompt overrides
# ORB_CONFIG=/absolute/path/to/config.json
# ORB_PROMPT_FILE=/absolute/path/to/voice-prompt.md
# ORB_TEMPERATURE=0.72
# ORB_PANEL_HEIGHT=12
# ORB_ACTIVITY_LINES=8
# ORB_DENSITY=1.30
# ORB_LOG_DIR=$HOME/.cache/orb/logs

# Pi-control permissions
# ORB_ALLOW_CANCEL_PI=true
# ORB_ALLOW_SET_MODEL=true
# ORB_ALLOW_SET_THINKING=true
# ORB_ALLOW_SET_TOOLS=true
# ORB_ALLOW_SHELL=true
# ORB_ALLOW_SCRATCHPAD_READ=true
# ORB_ALLOW_SCRATCHPAD_WRITE=true
# ORB_ALLOW_SCRATCHPAD_OUTSIDE_PROJECT=false

# Audio recovery
# ORB_AUDIO_BUFFER_MS=140
# ORB_AUDIO_MAX_BUFFER_MS=380
# ORB_AUDIO_RECOVERY_STEP_MS=40
# ORB_INTERRUPTION_STORM_COUNT=3
# ORB_INTERRUPTION_STORM_WINDOW_MS=1800
# ORB_INTERRUPTION_RECOVERY_MUTE_MS=320

# Scratchpad
# ORB_SCRATCHPAD_PANEL_HEIGHT=18
# ORB_SCRATCHPAD_MAX_BYTES=524288

# Convenience launcher behavior
# ORB_AUTO_START=1

# Advanced: use a specific prebuilt Go audio helper
# ORB_AUDIO_HELPER=/absolute/path/to/orb-audio
# ORB_AUDIO_RELEASE_VERSION=0.6.0
# ORB_AUDIO_RELEASE_BASE_URL=https://example.invalid/orb-audio
# ORB_GO=/opt/homebrew/bin/go
